{
  "name": "strapi-plugin-warning-tape",
  "version": "1.0.0",
  "description": "A police-tape banner across the top of the Strapi 5 admin with a scrolling message, so nobody mistakes preprod for production. Colour, text, speed and position are configurable; the environment name is detected server-side.",
  "keywords": [
    "admin",
    "banner",
    "environment",
    "marquee",
    "plugin",
    "strapi",
    "strapi-plugin",
    "warning"
  ],
  "license": "MIT",
  "author": {
    "name": "Ihor Sahaidak"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ihorsahaidak/strapi-plugin-warning-tape.git"
  },
  "homepage": "https://github.com/ihorsahaidak/strapi-plugin-warning-tape#readme",
  "bugs": {
    "url": "https://github.com/ihorsahaidak/strapi-plugin-warning-tape/issues"
  },
  "type": "commonjs",
  "exports": {
    "./package.json": "./package.json",
    "./strapi-admin": {
      "types": "./dist/admin/src/index.d.ts",
      "source": "./admin/src/index.ts",
      "import": "./dist/admin/index.mjs",
      "require": "./dist/admin/index.js",
      "default": "./dist/admin/index.js"
    },
    "./strapi-server": {
      "source": "./server/src/index.js",
      "import": "./dist/server/index.mjs",
      "require": "./dist/server/index.js",
      "default": "./dist/server/index.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "strapi-plugin build",
    "watch": "strapi-plugin watch",
    "watch:link": "strapi-plugin watch:link",
    "verify": "strapi-plugin verify"
  },
  "devDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/sdk-plugin": "^5.3.2",
    "@strapi/strapi": "^5.0.0",
    "@strapi/typescript-utils": "^5.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "prettier": "^3.3.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-intl": "^6.6.0",
    "react-router-dom": "^6.26.0",
    "styled-components": "^6.1.13",
    "typescript": "^5.5.4"
  },
  "peerDependencies": {
    "@strapi/design-system": "^2.0.0",
    "@strapi/icons": "^2.0.0",
    "@strapi/strapi": "^5.0.0",
    "react": "^18.0.0",
    "react-dom": "^18.0.0",
    "react-intl": "^6.0.0",
    "react-router-dom": "^6.0.0",
    "styled-components": "^6.0.0"
  },
  "strapi": {
    "kind": "plugin",
    "name": "warning-tape",
    "displayName": "Warning Tape",
    "description": "Scrolling environment banner across the top of the admin."
  },
  "engines": {
    "node": ">=18.0.0 <=24.x.x",
    "npm": ">=6.0.0"
  }
}
